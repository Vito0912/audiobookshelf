{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "removeComments": true
  },
  "include": [
    "server/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "client",
    "test",
    "**/*.spec.ts",
    "**/*.test.ts",
    "server/libs/**/*",
    ".devcontainer"
  ]
}
